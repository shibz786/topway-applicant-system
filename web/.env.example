# Copy to .env and fill in. Never commit real values.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Signs the local-disk storage stand-in's short-lived download URLs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not used once R2 is configured below.
FILE_SIGNING_SECRET=

# File storage (Cloudflare R2, private bucket) — once these are set, swap
# `storage` in src/lib/storage/adapter.ts to an R2 implementation.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Rate limiting + session blacklist (Upstash Redis) — once these are set,
# swap `kv` in src/lib/kv/adapter.ts to an Upstash-backed implementation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email (Resend) — once set, swap `email` in
# src/lib/email/adapter.ts to a Resend-backed implementation. Until then,
# "sent" emails are appended as JSON lines to .local-storage/emails.log.
RESEND_API_KEY=
