# Copy to .env and fill in. Never commit real values.

# Supabase Postgres — Project Settings -> Database -> Connection string.
# Read the long comment on the datasource block in prisma/schema.prisma
# before touching either of these — both landed on this exact shape after
# real, live failures, not by guessing:
#   DATABASE_URL  transaction-mode pooler (port 6543) — every query in the
#                 app, full stop. Scales to many concurrent Vercel
#                 instances; every interactive transaction the app used to
#                 need a second connection for got restructured away
#                 instead (see prisma/schema.prisma).
#   DIRECT_URL    Supabase's true direct connection (db.xxxx.supabase.co)
#                 — `prisma migrate` only, run from a real machine.
#                 IPv6-only, unreachable from Vercel's serverless network
#                 — never used by the running app itself.
DATABASE_URL="postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres?connection_limit=1"

# Supabase Storage — Project Settings -> API. Server-side only (the
# service role key bypasses Row Level Security, so it must never reach the
# browser — src/lib/storage/supabase-adapter.ts is the only file that
# reads it). Create a PRIVATE bucket named to match
# SUPABASE_STORAGE_BUCKET before setting these.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="candidate-files"

# Signs the local-disk storage stand-in's short-lived download URLs. Only
# read when SUPABASE_URL is unset (i.e. running locally without Supabase
# configured) — see src/lib/storage/adapter.ts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_SIGNING_SECRET=

# Rate limiting + session blacklist (Upstash Redis) — once these are set,
# swap `kv` in src/lib/kv/adapter.ts to an Upstash-backed implementation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email (Resend) — once set, swap `email` in
# src/lib/email/adapter.ts to a Resend-backed implementation. Until then,
# "sent" emails are appended as JSON lines to .local-storage/emails.log.
RESEND_API_KEY=
