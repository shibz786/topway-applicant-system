// Topway Applicant System — database schema
// See CLAUDE.md for the full spec this was generated from.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL: Supabase's TRANSACTION-mode pooler (port 6543,
  // ?pgbouncer=true&connection_limit=1) — what `db` (lib/db.ts) queries
  // through for everything, full stop. Getting here took three live
  // iterations, each a real failure caught by actually exercising the
  // deployed app, not by reasoning about it:
  //   1. Started on session-mode pooling (port 5432) because PgBouncer's
  //      transaction mode can route different statements within one
  //      logical $transaction() to different backend connections, which
  //      silently broke invoice-number allocation's interactive
  //      transaction — createInvoice reported success and navigated to
  //      the new invoice's page, but the row was never actually written.
  //   2. Session mode fixed that, but broke under real Vercel traffic:
  //      each serverless instance holds one dedicated connection for its
  //      whole lifetime in session mode, and its connection budget is
  //      much smaller (this project: capped at 15) — the very first
  //      login succeeded, every one after it failed with "FATAL: max
  //      clients reached in session mode".
  //   3. Tried a second client on a session-mode connection, used only
  //      for the app's handful of genuinely interactive transactions
  //      (rare enough that #2's budget shouldn't matter). Raw TCP
  //      connectivity checked out fine, but every actual query through it
  //      just hung indefinitely with no error at all — never
  //      conclusively diagnosed.
  // The real fix was removing the need for a second connection entirely:
  // invoice numbers are now a Postgres SEQUENCE (single atomic statement,
  // see prisma/migrations/20260824030000_invoice_number_sequence) instead
  // of a read-then-write-with-retry transaction, and every other
  // interactive (callback-form) $transaction() in the app got restructured
  // to an array-batch $transaction([...]) with any conditional read moved
  // to before it — batch transactions ARE safe under transaction-mode
  // pooling, unlike the callback form. See lib/db.ts's comment where
  // `dbDirect` used to be for the full list of what got restructured.
  // Don't add a NEW interactive $transaction(async (tx) => ...) callback
  // anywhere in this app without reading that comment first.
  url = env("DATABASE_URL")
  // DIRECT_URL: Supabase's true direct (non-pooled) connection
  // (?connection_limit=1, for the same per-instance-cap reason as above).
  // Used ONLY by `prisma migrate`, run from a real machine — Supabase's
  // direct connection is IPv6-only, which Vercel's serverless network
  // can't reach at all (confirmed live: DNS resolution for
  // db.<ref>.supabase.co fails outright from a Vercel function), so this
  // must never be reached by the running app itself.
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
}

enum DisputeType {
  NONE
  RUNAWAY
  REFUSAL_TO_WORK
  MEDICALLY_UNFIT
  OTHER
}

enum WorkerCategory {
  FIRST_TIMER
  EXPERIENCED
  CONTRACTED
}

enum Role {
  ADMIN
  STAFF
  AGENT
}

enum DestCountry {
  SAUDI_ARABIA
  KUWAIT
  OMAN
  QATAR
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         Role
  permissions  Json // { applications: bool, databank: bool, invoices: bool, agents: bool, tracking: bool }
  agentProfile Agent?
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  isActive     Boolean    @default(true)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
}

model Agent {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id])
  companyName    String
  country        String
  logoR2Key      String?
  dataBankAccess Boolean     @default(false)
  placements     Placement[]
  // Neither legacy data.json nor the original schema tracked these — the
  // Blacklist portal needed a real license/contact number to show per
  // agent (not just company name), so these are new, nullable since no
  // existing agent record has ever had one on file. licenseNo is a plain
  // free-text field, not tied to any specific registry format.
  licenseNo      String?
  contactNo      String?
  // B2: this agent's own default CV branding choice (left-hand "foreign
  // agency logo" slot). "LOGO" uses logoR2Key above by default unless
  // defaultLogoId below points at a different saved logo from the shared
  // library. Existing agents default to showing logoR2Key if they already
  // have one (preserves current behavior), EMPTY otherwise - never printed
  // the placeholder text either way (see the A1/B2 bug fix).
  defaultLogoMode String      @default("EMPTY") // "LOGO" | "COMPANY_NAME" | "EMPTY"
  defaultLogoId   String?
  logos           AgentLogo[]
}

// B2: a shared library of foreign-agency logos, not scoped one-per-Agent -
// staff/admin building a candidate's CV may want to brand it for whichever
// foreign counterpart it's actually headed to, which isn't always the one
// fixed Agent.logoR2Key. agentId is nullable: a logo can belong to one
// Agent's own library (they manage/delete their own) or be a general-
// purpose upload from staff with no single owning Agent.
model AgentLogo {
  id              String   @id @default(cuid())
  agentId         String?
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  r2Key           String
  mimeType        String
  label           String?
  createdAt       DateTime @default(now())

  @@index([agentId])
}

model Candidate {
  id               String         @id @default(cuid())
  fullName         String
  nationality      String
  dateOfBirth      DateTime
  passportNumber   String
  passportExpiry   DateTime
  // National ID / NIC number — a second identity document alongside the
  // passport, requested for the Blacklist portal so a candidate can be
  // matched even if their passport was renewed/replaced since a prior
  // dispute. Neither legacy data nor the original schema tracked this;
  // nullable since no existing (migrated) candidate has one on file.
  idNumber         String?
  phone            String?
  address          String?
  religion         String?
  category         WorkerCategory
  skills           String[]
  languages        String[]
  yearsExperience  Int            @default(0)
  contractDuration Int // months, typically 24
  inDatabank       Boolean        @default(false)
  // Client-reported bug (A1): these fields have always printed on the CV
  // template (candidate-pdf.tsx) as hardcoded blank rows - the legacy port
  // carried the layout over but nothing in the schema or form ever backed
  // them, so they could never actually be filled in. All nullable since no
  // existing candidate has ever had a value for any of them.
  heightCm             Int?
  weightKg             Int?
  maritalStatus        String?
  childrenCount        Int?
  passportIssueDate    DateTime?
  passportIssuePlace   String?
  educationGrade       String?
  educationYear        Int?
  // A real, unique reference number (A1/A5 bug: the CV's "REF NO." block
  // was printing candidate.fullName instead of an actual reference).
  // Backed by a Postgres SEQUENCE (refNoSeq below), same pattern as
  // Invoice.number - a single atomic nextval() is safe under transaction-
  // mode pooling, no interactive transaction needed. Format "TW-00001".
  refNo                String?   @unique
  // B2: this CV's own branding choice for the left-hand logo slot, frozen
  // the first time a CV is actually generated for this candidate (see
  // candidate-pdf resolution in the pdf route) - null means "not generated
  // yet, will resolve from the assigned agent's current default." Once
  // set, sticky even if the agent's default changes later (spec: "new CVs
  // use it, existing CVs keep their saved choice"), unless explicitly
  // overridden through the per-CV picker.
  cvLogoMode           String?   // "LOGO" | "COMPANY_NAME" | "EMPTY"
  cvLogoR2Key          String?   // set when cvLogoMode = "LOGO"
  documents        Document[]
  placements       Placement[]
  tracking         Tracking?
  disputes         Dispute[]
  invoiceItems     InvoiceItem[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  workHistory      WorkExperience[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([category])
  @@index([passportNumber])
  @@index([idNumber])
  @@index([inDatabank])
}

// A real gap, not a legacy feature that got dropped: neither the legacy
// index.html CV nor the original schema ever tracked prior overseas work
// history at all, only a single yearsExperience count. The user asked
// directly for this (multiple real prior placements, not just a number,
// plus the countries worked in surfaced on the CV), so it's new content,
// not a migration. One candidate can have several past placements, each
// with its own destination country, hence a real child table rather than
// another array column on Candidate.
model WorkExperience {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  country     String
  role        String? // e.g. "Housemaid", "Nanny" — optional, not every record will have it
  years       Int // whole years, matches the granularity yearsExperience already used
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model Tracking {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  applicationStatus ApplicationStatus @default(ACTIVE)
  onHoldReason      String?
  onHoldAt          DateTime?

  // Visa pipeline
  musanedDate DateTime?
  enjazDate   DateTime?
  bureauDate  DateTime?
  wakalahDate DateTime?
  embassyDate DateTime?
  paymentDate DateTime?

  // Departure & milestones — set together, never separately
  departureDate      DateTime?
  destinationCountry DestCountry?

  // Computed on save of departureDate, stored for queryability
  probationEndDate        DateTime?
  contractMidDate          DateTime?
  contractEndDate          DateTime?
  contractClosureNotified Boolean   @default(false)

  notes     String?
  updatedAt DateTime @updatedAt

  @@index([applicationStatus])
}

// Probation rules (stored in code as a const, not a DB table):
// SAUDI_ARABIA: 90 days | KUWAIT: 180 days | OMAN: 180 days | QATAR: 270 days

model Placement {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])

  employerName    String?
  startDate       DateTime  @default(now())
  endDate         DateTime?
  isCurrent       Boolean   @default(true)
  changeReason    String?
  remarketingDate DateTime? // when set, grants new agent visibility

  createdAt DateTime @default(now())

  @@index([candidateId])
  @@index([agentId])
}

model Dispute {
  id          String      @id @default(cuid())
  candidateId String
  candidate   Candidate   @relation(fields: [candidateId], references: [id])
  type        DisputeType
  notes       String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([candidateId])
}

model Document {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  type        String // "headshot" | "fullphoto" | "passport" | "alteration"
  r2Key       String // opaque UUID, never exposed to browser
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime  @default(now())

  @@index([candidateId])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique // auto-generated sequential
  status      String // "DRAFT" | "SENT" | "PAID" | "VOID"
  agentId     String?
  items       InvoiceItem[]
  totalAmount Decimal
  currency    String        @default("USD")
  notes       String?
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  // Advance payment: a real legacy feature (invoice.html's "Advance" row,
  // a None/Requested/Paid select plus an amount), migrated into
  // Invoice.notes as JSON with no schema home (see migrate-legacy-data.ts)
  // and left unbuilt until the user asked for it directly. totalAmount
  // above stays the raw sum of items (what the PDF's own "Subtotal" row
  // shows); advanceAmount is only ever subtracted from that at display
  // time, and only once actually PAID. A merely "requested" advance is a
  // note to the reader, not a change to what's owed yet, matching the
  // legacy calculator's own behavior exactly.
  advanceStatus String   @default("NONE") // "NONE" | "REQUESTED" | "PAID"
  advanceAmount Decimal?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id])
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  description String
  amount      Decimal
  quantity    Int        @default(1)

  @@index([invoiceId])
}

model Notification {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  userId      String // who receives it
  type        String // "CONTRACT_CLOSED" | "PROBATION_COMPLETE" | etc.
  seenAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([candidateId])
}

// Singleton (one row, fixed id "singleton") holding company bank details
// and contact footer used on generated invoice PDFs. Not part of the
// originally specified 12 models — added because the Invoicing Portal spec
// explicitly requires "bank details stored in DB, editable by admin only"
// and there's nowhere else for it to live. See CLAUDE.md Phase 2 notes.
model CompanySettings {
  id          String   @id @default("singleton")
  bankName    String?
  accountNo   String?
  accountName String?
  swiftCode   String?
  email       String?
  phone       String?
  fax         String?
  address     String?
  website     String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String     @id @default(cuid())
  actorId     String
  actor       User       @relation(fields: [actorId], references: [id])
  entityType  String
  entityId    String
  action      String
  diff        Json
  createdAt   DateTime   @default(now())
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  @@index([entityType, entityId])
  @@index([candidateId])
}
